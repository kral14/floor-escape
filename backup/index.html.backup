                            </div>
                            <button tabindex="-1" id="btn-perm-coin-val" onclick="buyPermanentUpgrade('coinVal'); this.blur();" class="w-full py-1.5 rounded-xl btn-diamond text-slate-950 font-orbitron font-bold text-xs flex items-center justify-center gap-1 active:scale-95 transition">
                                <span>YÜKSƏLT</span>
