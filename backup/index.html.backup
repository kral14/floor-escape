<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Floor Escape: Trap Bullet Deluxe</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    
    <style>
        * { box-sizing: border-box; user-select: none; -webkit-user-select: none; touch-action: none; outline: none !important; }
        body { font-family: 'Rajdhani', sans-serif; background: #07070d; color: #f1f5f9; overflow: hidden; }
        .font-orbitron { font-family: 'Orbitron', sans-serif; }

        .glass-panel {
            background: rgba(18, 18, 30, 0.82);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-card {
            background: rgba(26, 26, 42, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.06);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }

        .glass-card:hover:not(.disabled) {
            border-color: rgba(0, 255, 204, 0.5);
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(0, 255, 204, 0.18);
        }

        .glass-card.disabled { opacity: 0.45; cursor: not-allowed; filter: grayscale(0.8); }

        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        .btn-shimmer {
            background: linear-gradient(90deg, #00ffcc 0%, #00b8ff 50%, #00ffcc 100%);
            background-size: 200% 100%;
            animation: shimmer 3s infinite linear;
        }

        .btn-diamond {
            background: linear-gradient(90deg, #38bdf8 0%, #818cf8 50%, #38bdf8 100%);
            background-size: 200% 100%;
            animation: shimmer 3s infinite linear;
        }

        #toast-container {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 50;
            pointer-events: none;
        }

        .toast-msg {
            animation: fadeInOut 2.5s forwards ease-in-out;
            white-space: nowrap;
        }

        @keyframes fadeInOut {
            0% { opacity: 0; transform: translateY(-12px) scale(0.92); }
            12% { opacity: 1; transform: translateY(0) scale(1); }
            85% { opacity: 1; transform: translateY(0) scale(1); }
            100% { opacity: 0; transform: translateY(-15px) scale(0.95); }
        }

        .stat-panel {
            background: rgba(13, 13, 26, 0.92);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.07);
        }

        .trap-icon-box {
            transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .glass-card:hover .trap-icon-box { transform: scale(1.12) rotate(-4deg); }

        .d-pad-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.1s;
        }
        .d-pad-btn:active { background: rgba(0, 255, 204, 0.35); transform: scale(0.9); }

        .keybind-badge {
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid rgba(0, 255, 204, 0.4);
            transition: all 0.2s ease;
            min-width: 34px;
            text-align: center;
        }
        .keybind-badge:hover {
            border-color: #00ffcc;
            background: rgba(0, 255, 204, 0.25);
            transform: scale(1.08);
        }
        .keybind-badge.recording {
            animation: pulseRecord 0.8s infinite alternate;
            background: rgba(244, 63, 94, 0.45);
            border-color: #f43f5e;
            color: #ffffff;
            font-weight: 900;
        }
        @keyframes pulseRecord {
            from { box-shadow: 0 0 6px rgba(244, 63, 94, 0.5); }
            to { box-shadow: 0 0 16px rgba(244, 63, 94, 1); }
        }

        .shake {
            animation: screenShake 0.35s cubic-bezier(.36,.07,.19,.97) both;
        }
        @keyframes screenShake {
            10%, 90% { transform: translate3d(-1px, 0, 0); }
            20%, 80% { transform: translate3d(2px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-3px, 0, 0); }
            40%, 60% { transform: translate3d(3px, 0, 0); }
        }

        @media (max-width: 640px) {
            .glass-panel { padding: 8px; }
            .stat-panel { padding: 4px 8px; }
        html, body {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            touch-action: none;
            overscroll-behavior: none;
        }
    </style>
</head>
<body class="flex items-center justify-center h-screen w-screen overflow-hidden bg-slate-950 select-none m-0 p-2">

    <!-- SABİT ÖLÇÜLÜ ƏSAS OYUN ÇƏRÇİVƏSİ (1140x750 px) -->
    <div id="game-app-wrapper" style="width: 1140px; height: 750px; min-width: 1140px; max-width: 1140px; min-height: 750px; max-height: 750px;" class="flex flex-col justify-between items-center relative select-none">

        <!-- ÜST STATİSTİKA VƏ MENYU PANELİ -->
        <header class="w-full glass-panel rounded-2xl p-3 flex justify-between items-center shadow-2xl z-20 gap-2 shrink-0" style="height: 60px; min-height: 60px; max-height: 60px;">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center font-orbitron font-bold text-lg text-slate-950 shadow-lg shadow-cyan-500/30">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <div>
                <h1 class="font-orbitron font-extrabold text-sm sm:text-base tracking-wider text-cyan-400 leading-tight">FLOOR ESCAPE</h1>
                <p class="text-[11px] text-slate-400 font-semibold flex items-center gap-2">
                    <span>LAVAYA MƏRMİ ATAN</span>
                    <span class="text-amber-400 font-orbitron text-[10px]" id="stat-best-floor">🏆 REKORD: 1</span>
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3 my-1 sm:my-0 flex-wrap">
            <!-- QIZIL -->
            <div class="flex items-center gap-2 stat-panel px-3 py-1.5 rounded-xl border border-amber-500/30">
                <i class="fa-solid fa-coins text-amber-400 text-base animate-pulse"></i>
                <div class="flex flex-col">
                    <span class="text-[10px] text-slate-400 leading-none">QIZIL</span>
                    <span id="stat-gold" class="font-orbitron text-amber-300 font-bold text-sm sm:text-base">0</span>
                </div>
            </div>

            <!-- ALMAZ (DIAMOND) -->
            <div class="flex items-center gap-2 stat-panel px-3 py-1.5 rounded-xl border border-sky-400/40 bg-sky-950/20">
                <i class="fa-solid fa-gem text-sky-400 text-base animate-bounce"></i>
                <div class="flex flex-col">
                    <span class="text-[10px] text-sky-300 leading-none font-bold">ALMAZ</span>
                    <span id="stat-diamonds" class="font-orbitron text-sky-200 font-black text-sm sm:text-base">0</span>
                </div>
            </div>

            <!-- QAT -->
            <div class="flex items-center gap-2 stat-panel px-3 py-1.5 rounded-xl border border-cyan-500/30">
                <i class="fa-solid fa-stairs text-cyan-400 text-base"></i>
                <div class="flex flex-col">
                    <span class="text-[10px] text-slate-400 leading-none">QAT</span>
                    <span id="stat-floor" class="font-orbitron text-cyan-300 font-bold text-sm sm:text-base">1</span>
                </div>
            </div>

            <!-- TƏLƏB OLUNAN XAL BARI -->
            <div class="flex items-center gap-2 stat-panel px-3 py-1.5 rounded-xl border border-emerald-500/30 min-w-[105px] sm:min-w-[125px]">
                <i class="fa-solid fa-shield-halved text-emerald-400 text-base"></i>
                <div class="flex flex-col w-full">
                    <div class="flex justify-between text-[10px] text-slate-400 mb-0.5">
                        <span>XAL</span>
                        <span id="stat-req-txt" class="text-emerald-300 font-bold">0/3</span>
                    </div>
                    <div class="w-full bg-slate-800 rounded-full h-1.5 overflow-hidden">
                        <div id="stat-req-bar" class="bg-gradient-to-r from-emerald-500 to-cyan-400 h-full w-0% transition-all duration-500"></div>
                    </div>
                </div>
            </div>

            <!-- KOMBO -->
            <div class="flex items-center gap-2 stat-panel px-2.5 py-1.5 rounded-xl border border-purple-500/30 hidden sm:flex">
                <i class="fa-solid fa-fire text-purple-400 text-base"></i>
                <div class="flex flex-col">
                    <span class="text-[10px] text-slate-400 leading-none">KOMBO</span>
                    <span id="stat-combo" class="font-orbitron text-purple-300 font-bold text-sm">0</span>
                </div>
            </div>

            <!-- DASH COOLDOWN BARI -->
            <div class="flex items-center gap-2 stat-panel px-2.5 py-1.5 rounded-xl border border-blue-500/30">
                <i class="fa-solid fa-forward text-blue-400 text-base"></i>
                <div class="flex flex-col">
                    <span class="text-[10px] text-slate-400 leading-none">DASH</span>
                    <span id="stat-dash-status" class="font-orbitron text-blue-300 font-bold text-xs">HAZIR</span>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <!-- ALMAZ SAYĞACI (LABORATORİYA YALNIZ OYUN BİTDİKDƏ AÇILIR) -->
            <div class="px-3 py-1.5 rounded-xl bg-sky-500/15 border border-sky-400/30 text-sky-300 font-orbitron font-bold text-xs flex items-center gap-1.5 shadow-sm" title="Almazlar: Yalnız oyun bitdikdən sonra Laboratoriyada istifadə olunur">
                <i class="fa-solid fa-gem text-sky-400 text-xs"></i>
                <span id="stat-header-diamonds">0 💎</span>
            </div>
            <button tabindex="-1" id="btn-sound" onclick="toggleAudio(); this.blur();" class="w-9 h-9 rounded-xl glass-card flex items-center justify-center text-slate-300 hover:text-cyan-400 transition" title="Səsi Aç/Bağla">
                <i class="fa-solid fa-volume-high text-sm"></i>
            </button>
            <button tabindex="-1" id="btn-pause" onclick="togglePause(); this.blur();" class="w-9 h-9 rounded-xl glass-card flex items-center justify-center text-slate-300 hover:text-amber-400 transition" title="Fasilə">
                <i class="fa-solid fa-pause text-sm"></i>
            </button>
        </div>
    </header>

    <div id="toast-container"></div>

    <!-- ƏSAS OYUN VƏ MAĞAZA -->
    <main id="main-view" style="width: 1140px; height: 680px; min-width: 1140px; max-width: 1140px; min-height: 680px; max-height: 680px;" class="flex flex-row gap-3 relative overflow-hidden shrink-0">
        
        <!-- OYUN CANVAS-I -->
        <div id="canvas-container" style="width: 800px; height: 680px; min-width: 800px; max-width: 800px; min-height: 680px; max-height: 680px;" class="relative bg-slate-950/95 rounded-2xl overflow-hidden glass-panel border border-slate-800 shadow-inner flex shrink-0">
            
            <canvas id="gameCanvas" width="800" height="680" style="width: 800px; height: 680px; min-width: 800px; max-width: 800px; min-height: 680px; max-height: 680px; display: block;" class="cursor-crosshair bg-slate-950/90"></canvas>

            <!-- QAT TAYMERİ -->
            <div class="absolute top-4 right-4 glass-panel px-3 py-1.5 rounded-full border border-slate-700 flex items-center gap-2 pointer-events-none z-10">
                <i class="fa-solid fa-clock text-cyan-400 text-xs"></i>
                <span id="floor-timer" class="font-orbitron text-xs text-slate-300 tracking-wider">⏱ 0s</span>
            </div>

            <!-- SƏRHƏD STATUSU -->
            <div class="absolute top-4 left-1/2 -translate-x-1/2 glass-panel px-4 py-1.5 rounded-full border border-slate-700 flex items-center gap-2 transition-all duration-300 pointer-events-none z-10">
                <div id="border-icon-dot" class="w-3 h-3 rounded-full bg-rose-500 animate-pulse"></div>
                <span id="border-status-text" class="font-orbitron text-xs text-slate-300 tracking-wider">SƏRHƏD: BAĞLI</span>
            </div>

            <!-- NÖVBƏTİ SİKKƏ GERİ SAYIM TAYMERİ -->
            <div class="absolute top-4 left-4 glass-panel px-3 py-1.5 rounded-xl border border-amber-500/40 flex items-center gap-2 pointer-events-none z-10 bg-slate-950/70 shadow-lg">
                <i class="fa-solid fa-coins text-amber-400 text-xs animate-spin" style="animation-duration: 4s;"></i>
                <div class="flex flex-col">
                    <span class="text-[9px] text-amber-300/80 font-semibold leading-none">NÖVBƏTİ SİKKƏ</span>
                    <span id="coin-countdown-timer" class="font-orbitron text-xs text-amber-300 font-bold">5.0s</span>
                </div>
            </div>

            <!-- MOBİL TOXUNMA NƏZARƏTİ (D-PAD) -->
            <div id="touch-controls" class="absolute bottom-4 left-4 z-20 flex flex-col items-center gap-1 opacity-80 sm:hidden">
                <button tabindex="-1" class="d-pad-btn w-12 h-12 rounded-xl text-white font-bold flex items-center justify-center" ontouchstart="handleTouchStart('up')" ontouchend="handleTouchEnd('up')">
                    <i class="fa-solid fa-angle-up text-xl"></i>
                </button>
                <div class="flex gap-1">
                    <button tabindex="-1" class="d-pad-btn w-12 h-12 rounded-xl text-white font-bold flex items-center justify-center" ontouchstart="handleTouchStart('left')" ontouchend="handleTouchEnd('left')">
                        <i class="fa-solid fa-angle-left text-xl"></i>
                    </button>
                    <button tabindex="-1" class="d-pad-btn w-12 h-12 rounded-xl text-white font-bold flex items-center justify-center" ontouchstart="handleTouchStart('down')" ontouchend="handleTouchEnd('down')">
                        <i class="fa-solid fa-angle-down text-xl"></i>
                    </button>
                    <button tabindex="-1" class="d-pad-btn w-12 h-12 rounded-xl text-white font-bold flex items-center justify-center" ontouchstart="handleTouchStart('right')" ontouchend="handleTouchEnd('right')">
                        <i class="fa-solid fa-angle-right text-xl"></i>
                    </button>
                </div>
            </div>

            <!-- MOBİL ATƏŞ VƏ DASH DÜYMƏLƏRİ -->
            <div class="absolute bottom-4 right-4 z-20 flex gap-2 sm:hidden">
                <button tabindex="-1" onclick="triggerPlayerDash(); this.blur();" class="w-14 h-14 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 text-white font-bold flex items-center justify-center shadow-lg shadow-blue-500/40 active:scale-95 transition-transform" title="Dash">
                    <i class="fa-solid fa-forward text-lg"></i>
                </button>
                <button tabindex="-1" onclick="fireBullet('wall'); this.blur();" class="w-14 h-14 rounded-full bg-gradient-to-tr from-amber-500 to-yellow-600 text-slate-950 font-bold flex items-center justify-center shadow-lg shadow-amber-500/40 active:scale-95 transition-transform" title="Barrikada At">
                    <i class="fa-solid fa-cubes text-xl"></i>
                </button>
            </div>



            <!-- MODAL: QAT KEÇİLDİ -->
            <div id="floor-clear-overlay" class="absolute inset-0 bg-slate-950/85 backdrop-blur-md z-30 flex flex-col justify-center items-center p-6 text-center transition-all duration-300 hidden pointer-events-auto select-none">
                <div class="w-16 h-16 rounded-2xl bg-sky-500/20 border border-sky-500/40 flex items-center justify-center text-sky-400 text-3xl mb-3 animate-bounce">
                    <i class="fa-solid fa-gem"></i>
                </div>
                <h2 class="font-orbitron font-black text-2xl text-sky-400 mb-1">QAT FƏTH EDİLDİ!</h2>
                <p id="floor-clear-desc" class="text-slate-300 text-xs mb-2">Növbəti qata keçirsiniz...</p>
                <div class="px-4 py-1.5 rounded-full bg-sky-500/20 border border-sky-400/50 text-sky-300 font-orbitron text-xs font-bold animate-pulse">
                    💎 +1 ALMAZ QAZANDINIZ!
                </div>
            </div>

            <!-- MODAL: MƏĞLUBİYYƏT EKRANI -->
            <div id="modal-overlay" class="absolute inset-0 bg-slate-950/90 backdrop-blur-md z-40 flex flex-col justify-center items-center p-6 text-center transition-all duration-300 hidden">
                <div class="w-20 h-20 rounded-2xl bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-rose-500 text-4xl mb-4 animate-bounce">
                    <i class="fa-solid fa-skull"></i>
                </div>
                <h2 class="font-orbitron font-black text-3xl text-rose-500 mb-2">MƏĞLUB OLDUNUZ!</h2>
                <p class="text-slate-300 max-w-md text-sm mb-6">Lava dalğası sizi yaxaladı! Qalıcı yüksəltmələrdən istifadə edərək daha güclü başlayın.</p>

                <div class="grid grid-cols-4 gap-3 w-full max-w-sm mb-6 text-left">
                    <div class="glass-card p-2 rounded-xl text-center">
                        <span class="text-[10px] text-slate-400 block">QAT</span>
                        <span id="final-floor" class="font-orbitron font-bold text-cyan-400 text-lg">1</span>
                    </div>
                    <div class="glass-card p-2 rounded-xl text-center">
                        <span class="text-[10px] text-slate-400 block">QIZIL</span>
                        <span id="final-gold" class="font-orbitron font-bold text-amber-400 text-lg">0</span>
                    </div>
                    <div class="glass-card p-2 rounded-xl text-center">
                        <span class="text-[10px] text-slate-400 block">ATILAN</span>
                        <span id="final-traps" class="font-orbitron font-bold text-purple-400 text-lg">0</span>
                    </div>
                    <div class="glass-card p-2 rounded-xl text-center">
                        <span class="text-[10px] text-slate-400 block">ALMAZ</span>
                        <span id="final-diamonds" class="font-orbitron font-bold text-sky-400 text-lg">0</span>
                    </div>
                </div>

                <div class="flex gap-3">
                    <button tabindex="-1" onclick="togglePermanentUpgradesModal(); this.blur();" class="btn-diamond text-slate-950 font-orbitron font-bold px-5 py-2.5 rounded-xl shadow-lg active:scale-95 transition text-xs">
                        <i class="fa-solid fa-gem mr-1"></i>YÜKSƏLTMƏLƏR
                    </button>
                    <button tabindex="-1" onclick="restartGame(); this.blur();" class="btn-shimmer text-slate-950 font-orbitron font-bold px-6 py-2.5 rounded-xl shadow-lg hover:opacity-90 transition active:scale-95 text-xs">
                        <i class="fa-solid fa-rotate-right mr-1"></i>YENİDƏN BAŞLA
                    </button>
                </div>
            </div>

            <!-- MODAL: FASİLƏ -->
            <div id="pause-overlay" class="absolute inset-0 bg-slate-950/80 backdrop-blur-sm z-30 flex flex-col justify-center items-center p-6 text-center hidden">
                <h2 class="font-orbitron font-bold text-2xl text-amber-400 mb-4">⏸ OYUN DAYANDI</h2>
                <p class="text-slate-400 text-xs mb-6 max-w-sm">W, A, S, D və ya Ox düymələri ilə hərəkət edin.<br><b>SPACE</b> ilə Dash edin.<br>Qısayollarla mərmiləri dərhal lavaya doğru atın!</p>
                <button tabindex="-1" onclick="togglePause(); this.blur();" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-orbitron font-bold px-6 py-2.5 rounded-xl shadow-lg transition">
                    DAVAM ET
                </button>
            </div>

            <!-- MODAL: QALICI YÜKSƏLTMƏLƏR MENYUSU (DIAMOND SHOP) -->
            <div id="perm-upgrades-modal" class="absolute inset-0 bg-slate-950/95 backdrop-blur-md z-40 flex flex-col justify-center items-center p-4 transition-all duration-300 hidden">
                <div class="glass-panel p-5 rounded-3xl w-full max-w-lg border border-sky-500/40 shadow-2xl flex flex-col gap-4">
                    <div class="flex justify-between items-center pb-3 border-b border-slate-800">
                        <div class="flex items-center gap-2.5">
                            <div class="w-9 h-9 rounded-xl bg-sky-500/20 border border-sky-400/40 flex items-center justify-center text-sky-400 text-lg">
                                <i class="fa-solid fa-gem"></i>
                            </div>
                            <div>
                                <h2 class="font-orbitron font-black text-sm sm:text-base text-slate-100">QALICI LABORATORİYA</h2>
                                <p class="text-[10px] text-slate-400 font-semibold">Maksimum Lv.10. Qiymət: səviyyə qədər Almaz (1-9 💎)</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <div class="flex items-center gap-1.5 px-3 py-1 rounded-xl bg-sky-500/15 border border-sky-400/40">
                                <i class="fa-solid fa-gem text-sky-400 text-xs animate-pulse"></i>
                                <span id="modal-diamonds-count" class="font-orbitron text-sky-300 font-bold text-xs">0 💎</span>
                            </div>
                            <button tabindex="-1" onclick="togglePermanentUpgradesModal(); this.blur();" class="w-8 h-8 rounded-xl glass-card flex items-center justify-center text-slate-400 hover:text-white">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-[380px] overflow-y-auto pr-1">
                        <!-- 1. BAZA SÜRƏT -->
                        <div class="glass-card p-3 rounded-2xl flex flex-col justify-between gap-2 border border-slate-800">
                            <div>
                                <div class="flex justify-between items-center mb-1">
                                    <span class="font-orbitron text-xs font-bold text-slate-200 flex items-center gap-1.5">
                                        <i class="fa-solid fa-bolt text-cyan-400"></i> Baza Sürət
                                    </span>
                                    <span id="perm-lvl-speed" class="text-[10px] font-orbitron font-bold text-cyan-400 bg-cyan-950/50 px-2 py-0.5 rounded-md">Lv.1 (4.0)</span>
                                </div>
                                <p class="text-[10px] text-slate-400">Yeni oyuna başlarkən oyunçunun baza sürəti (Max Lv.10)</p>
                            </div>
                            <button tabindex="-1" id="btn-perm-speed" onclick="buyPermanentUpgrade('speed'); this.blur();" class="w-full py-1.5 rounded-xl btn-diamond text-slate-950 font-orbitron font-bold text-xs flex items-center justify-center gap-1 active:scale-95 transition">
                                <span>YÜKSƏLT</span>
                                <span class="bg-slate-950/30 text-white px-2 py-0.5 rounded-md text-[10px]">1 💎</span>
                            </button>
                        </div>

                        <!-- 2. BAZA MAQNİT SAHƏSİ -->
                        <div class="glass-card p-3 rounded-2xl flex flex-col justify-between gap-2 border border-slate-800">
                            <div>
                                <div class="flex justify-between items-center mb-1">
                                    <span class="font-orbitron text-xs font-bold text-slate-200 flex items-center gap-1.5">
                                        <i class="fa-solid fa-magnet text-amber-400"></i> Baza Maqnit
                                    </span>
                                    <span id="perm-lvl-magnet" class="text-[10px] font-orbitron font-bold text-amber-400 bg-amber-950/50 px-2 py-0.5 rounded-md">Lv.1 (45px)</span>
                                </div>
                                <p class="text-[10px] text-slate-400">Sikkələri daha uzaqdan cəzb etmə radiusu (Max Lv.10)</p>
                            </div>
                            <button tabindex="-1" id="btn-perm-magnet" onclick="buyPermanentUpgrade('magnet'); this.blur();" class="w-full py-1.5 rounded-xl btn-diamond text-slate-950 font-orbitron font-bold text-xs flex items-center justify-center gap-1 active:scale-95 transition">
                                <span>YÜKSƏLT</span>
                                <span class="bg-slate-950/30 text-white px-2 py-0.5 rounded-md text-[10px]">1 💎</span>
                            </button>
                        </div>

                        <!-- 3. SİKKƏNİN QIZIL DƏYƏRİ -->
                        <div class="glass-card p-3 rounded-2xl flex flex-col justify-between gap-2 border border-slate-800">
                            <div>
                                <div class="flex justify-between items-center mb-1">
                                    <span class="font-orbitron text-xs font-bold text-slate-200 flex items-center gap-1.5">
