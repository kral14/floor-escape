# ========================================================
# Floor Escape - Mühit Dəyişənləri (Environment Variables)
# ========================================================
# Bu fayl nümunədir. İstehsalat və ya yeni serverdə bu faylın 
# adını '.env' edərək öz parametrlərinizi qeyd edin.

# 1. Verilənlər Bazası (PostgreSQL Connection String)
# Əgər boş buraxılarsa, sistem avtomatik yerli SQLite (data/floor_escape.db) istifadə edəcək.
DATABASE_URL=postgresql://user_floorgame:sifre@host:5432/db_floorgame

# 2. Server Rejimi
# 1 = Əsas/Mərkəzi Server (Bütün sorğuları birbaşa öz bazasında emal edir)
# 0 = Lokal Developer Rejimi (Sorğuları REMOTE_SERVER_URL-ə yönləndirir)
IS_REMOTE_SERVER=1

# 3. Əgər IS_REMOTE_SERVER=0 olarsa, sorğuların göndəriləcəyi uzaq serverin ünvanı
REMOTE_SERVER_URL=http://84.8.148.216:8082

# 4. Serverin Dinləyəcəyi Port (Standart: 4000 və ya 8082)
PORT=4000

# 5. Sərt Rejim (Strict Mode)
# 1 = PostgreSQL qoşulmadıqda server dərhal xəta versin və dayansın (tövsiyə olunur)
# 0 = PostgreSQL qoşulmadıqda ehtiyat olaraq lokal SQLite-a keçsin
DB_STRICT=1
