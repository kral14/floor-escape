                    <div id="shop-shock" onclick="fireBullet('shock')" class="glass-card p-2.5 rounded-xl flex items-center gap-3 cursor-pointer relative overflow-hidden group">
                        <div class="w-11 h-11 rounded-2xl bg-purple-950/60 border border-purple-500/40 flex items-center justify-center trap-icon-box shadow-inner text-purple-400 text-xl">
                            <i class="fa-solid fa-bolt drop-shadow-[0_0_8px_rgba(192,132,252,0.8)]"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between items-center mb-0.5">
