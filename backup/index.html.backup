                        </div>

                        <!-- 4. SİKKƏNİN ÇIXIŞ VAXTI (TEZLİYİ) -->
                        <div class="glass-card p-3 rounded-2xl flex flex-col justify-between gap-2 border border-slate-800">
                            <div>
                                <div class="flex justify-between items-center mb-1">
